# ══════════════════════════════════════════════════════════════════════════════
# LUVIIO — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
#
# Required: SB_URL, SB_KEY, SB_SERVICE_ROLE_KEY
# Required (payments): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
# Required (email): RESEND_API_KEY, FROM_EMAIL
# Optional (push): VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY
# ══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Luviio
APP_ENV=production
APP_VERSION=0.1.0
DEBUG=false
SENTRY_DSN=

FRONTEND_URL=https://www.luviio.in
ALLOWED_ORIGINS=https://luviio.in,https://www.luviio.in,http://localhost:7700,http://127.0.0.1:7700
RATE_LIMIT_PER_MINUTE=60

# ── Supabase ──────────────────────────────────────────────────────────────────
SB_URL=https://your-project.supabase.co
SB_KEY=bb
SB_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Shiprocket ─────────────────────────────────────────────────────────────────
# Keep sandbox and production hosts explicit. Sandbox values below are the
# Shiprocket sandbox endpoints already used by Luviio; replace them only if
# Shiprocket gives this account a different sandbox base URL.
SHIPROCKET_ENV=sandbox
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_SANDBOX_BASE_URL=https://api-sandbox.shiprocket.in/v1/external
SHIPROCKET_SANDBOX_SERVICEABILITY_BASE_URL=https://serviceability-sandbox.shiprocket.in
# Optional generic overrides for provider-issued environments:
SHIPROCKET_BASE_URL=
SHIPROCKET_SERVICEABILITY_BASE_URL=
SHIPROCKET_PRODUCTION_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PRODUCTION_SERVICEABILITY_BASE_URL=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_RATE_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_DEFAULT_LENGTH_CM=10
SHIPROCKET_DEFAULT_BREADTH_CM=10
SHIPROCKET_DEFAULT_HEIGHT_CM=10

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=Luviio <orders@luviio.in>

# ── VAPID ─────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@luviio.in

# Server-side HSN typeahead provider (keep secret; never expose to frontend)
GST_ACCELERATOR_API_KEY=
