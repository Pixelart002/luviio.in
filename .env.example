# ══════════════════════════════════════════════════════════════════════════════
# LUVIIO — Environment Configuration   
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
#
# Required: SB_URL, SB_KEY, SB_SERVICE_ROLE_KEY
# Required (payments): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
# Required (email): RESEND_API_KEY, FROM_EMAIL
# Optional (push): VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY
# ══════════════════════════════════════════════════════════════════════════════


# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Luviio
APP_ENV=production
DEBUG=false

# Comma-separated list of allowed origins (no spaces)
ALLOWED_ORIGINS=https://luviio.in,https://www.luviio.in,http://localhost:7700,http://127.0.0.1:7700

# Requests per minute per IP (global default)
RATE_LIMIT_PER_MINUTE=60


# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
# https://app.supabase.com/project/YOUR_PROJECT_ID/settings/api

# Project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
SB_URL=https://your-project.supabase.co

# Anon/Public key (for client-side auth, RLS-respecting queries)
SB_KEY=bb

# Service Role Key (for server-side admin operations — bypasses RLS)
# ⚠️ NEVER expose this to frontend or client-side code!
SB_SERVICE_ROLE_KEY=

# ── Stripe (Payments) ─────────────────────────────────────────────────────────
# Get these from: Stripe Dashboard → Developers → API keys
# https://dashboard.stripe.com/apikeys

# Secret key (server-side only)
# Test: sk_test_... | Live: sk_live_...
STRIPE_SECRET_KEY=


# Webhook signing secret (for verifying Stripe webhook events)
# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=

# ── Resend (Email) ────────────────────────────────────────────────────────────
# Get these from: https://resend.com/api-keys

# API Key
RESEND_API_KEY=
# Sender email (must be verified in Resend dashboard)
# Format: "Display Name <email@yourdomain.com>"
 FROM_EMAIL=Luviio <orders@luviio.in>
  
  
  # ── VAPID (Push Notifications) ────────────────────────────────────────────────
  # Generate keys at: https://web-push-codelab.glitch.me/
  # Or use: npx web-push generate-vapid-keys
  
  # Public key (sent to frontend)
  VAPID_PUBLIC_KEY=BKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
  
  # Private key (server-side only)
  VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
  
  # Contact email for VAPID claims
  VAPID_CLAIM_EMAIL=mailto:admin@luviio.in
  
  
  # ── Pricing (Fallback — DB pricing_config table is the PRIMARY source) ────────
  # These values MUST match the defaults in pricing_config table
  # Cart & Checkout use LIVE pricing from DB — these are fallbacks only
  
  # Free shipping threshold (in INR)
  SHIPPING_THRESHOLD=999.00
  
  # Flat shipping fee (in INR)
  SHIPPING_FLAT=99.00
  
  # Tax rate (decimal — 0.18 = 18% GST)
  TAX_RATE=0.18
  
  
  # ── Resend Webhook (Optional — for email delivery tracking) ───────────────────
  # RESEND_WEBHOOK_SECRET=whsec_...