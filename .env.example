# ══════════════════════════════════════════════════════════════════════════════
# LUVIIO — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
#
# Required: SB_URL, SB_KEY, SB_SERVICE_ROLE_KEY
# Required (payments): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
# Required (email): RESEND_API_KEY, FROM_EMAIL
# Optional (push): VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY
# ══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Luviio
APP_ENV=production
APP_VERSION=0.1.0
DEBUG=false
SENTRY_DSN=

# Public frontend origin used by server-rendered product share pages.
FRONTEND_URL=https://www.luviio.in

# Comma-separated list of allowed origins (no spaces)
ALLOWED_ORIGINS=https://luviio.in,https://www.luviio.in,http://localhost:7700,http://127.0.0.1:7700

# Requests per minute per IP (global default)
RATE_LIMIT_PER_MINUTE=60

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
# https://app.supabase.com/project/YOUR_PROJECT_ID/settings/api

# Project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
SB_URL=https://your-project.supabase.co

# Anon/Public key (for client-side auth, RLS-respecting queries)
SB_KEY=bb

# Service Role Key (for server-side admin operations — bypasses RLS)
# NEVER expose this to frontend or client-side code!
SB_SERVICE_ROLE_KEY=

# ── Stripe (Payments) ─────────────────────────────────────────────────────────
# Get these from: Stripe Dashboard → Developers → API keys
# https://dashboard.stripe.com/apikeys

# Secret key (server-side only)
# Test: sk_test_... | sk_live_...
STRIPE_SECRET_KEY=

# Webhook signing secret (for verifying Stripe webhook events)
# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=

# ── Shiprocket (Shipping) ─────────────────────────────────────────────────────
# Sandbox:
#   API/auth/order host: https://api-sandbox.shiprocket.in
#   Serviceability host: https://serviceability-sandbox.shiprocket.in
# Production:
#   https://apiv2.shiprocket.in/v1/external
# Use the API User credentials created for the selected Shiprocket environment.
SHIPROCKET_ENV=production
# Sandbox is blocked automatically when APP_ENV=production.
SHIPROCKET_ALLOW_SANDBOX=false
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Required for checkout rate calculation (warehouse/pickup PIN)
SHIPROCKET_PICKUP_POSTCODE=
# Used only when product weights are not configured; keep this configurable.
SHIPROCKET_RATE_DEFAULT_WEIGHT_KG=0.5
# Sandbox override (only for sandbox credentials/testing):
# SHIPROCKET_ENV=sandbox
# SHIPROCKET_BASE_URL=https://api-sandbox.shiprocket.in/v1/external
# SHIPROCKET_SERVICEABILITY_BASE_URL=https://serviceability-sandbox.shiprocket.in

# ── Resend (Email) ────────────────────────────────────────────────────────────
# Get these from: https://resend.com/api-keys
RESEND_API_KEY=
# Sender email (must be verified in Resend dashboard)
# Format: "Display Name <email@yourdomain.com>"
FROM_EMAIL=Luviio <orders@luviio.in>

# ── VAPID (Push Notifications) ────────────────────────────────────────────────
# Generate keys at: https://web-push-codelab.glitch.me/
# Or use: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_CLAIM_EMAIL=mailto:admin@luviio.in

# ── Resend Webhook (Optional — for email delivery tracking) ───────────────────
# RESEND_WEBHOOK_SECRET=whsec_...
