# Local development API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Stripe publishable key for browser checkout.
# Never put Stripe secret keys or any backend secret in VITE_* variables.
# Reference frontend uses VITE_STRIPE_PK; aliases are supported by the app.
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PK=
